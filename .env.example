DB_USER_LOCAL=root
DB_PASS_LOCAL=
DB_NAME_LOCAL=real_estate

# Database (Production)
DB_HOST=mysql.example.com
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Initial Admin Setup Credentials
